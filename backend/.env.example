# 访问 YouTube 等境外站点时配置代理（Clash / V2Ray 等本地端口）
# YTDLP_PROXY=http://127.0.0.1:7890
# 也可使用系统环境变量 HTTPS_PROXY / HTTP_PROXY

# AI 视频总结
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
WHISPER_MODEL=small
WHISPER_MAX_DURATION=3600

# 本地视频上传
UPLOAD_MAX_SIZE_MB=500
UPLOAD_MAX_DURATION=3600

# 用户认证与会员
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_EXPIRE_DAYS=7
DATABASE_URL=sqlite:///./omnivid.db
FREE_DAILY_AI_LIMIT=10
VIP_DURATION_DAYS=30

# Stripe 支付（Test mode）
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx
FRONTEND_URL=http://localhost:5173

# 访问 Stripe API 时代理（与 YTDLP_PROXY 可相同）
# HTTPS_PROXY=http://127.0.0.1:7890
