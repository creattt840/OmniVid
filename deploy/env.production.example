# 生产环境变量模板
# 复制到 /www/wwwroot/omnivid-api/.env 并填入真实值

# ========== 必改 ==========
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
DEEPSEEK_API_KEY=sk-REPLACE_ME
FRONTEND_URL=https://your-domain.com

# ========== 数据库 ==========
DATABASE_URL=sqlite:///./omnivid.db
FREE_DAILY_AI_LIMIT=10

# ========== AI ==========
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
WHISPER_MODEL=small
WHISPER_MAX_DURATION=3600

# ========== 上传 ==========
UPLOAD_MAX_SIZE_MB=500
UPLOAD_MAX_DURATION=3600

# ========== 邮件（QQ 邮箱）==========
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_qq@qq.com
SMTP_PASSWORD=your_qq_smtp_auth_code
SMTP_FROM=your_qq@qq.com
SMTP_USE_SSL=true

# ========== 可选：YouTube 代理（大陆服务器）==========
# YTDLP_PROXY=http://127.0.0.1:7890

# ========== Stripe（暂未开放，可留空）==========
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
